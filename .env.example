# Copy this to `.env.local` and uncomment the API target you want.
# Vite reads env only at startup → restart `npm run dev` after changing.
#
# Precedence (highest first): .env.local  >  .env.[mode]  >  .env
# `.env.local` is git-ignored, so it's safe for per-developer settings.

# ── API base URL — pick ONE (must include the trailing /api) ──
#   Live:   https://team.seewework.com/api
#   Dev:    https://teamdev.seewework.com/api
#   Local:  http://localhost:8000/api
VITE_API_BASE_URL=https://teamdev.seewework.com/api

# ── Optional: origin that serves uploaded files (photos, certificates, agreements).
#    Defaults to the API host minus `/api`. Override to load files from a
#    different host than the API (e.g. API local, files on the live server).
# VITE_ASSET_BASE_URL=https://teamdev.seewework.com
