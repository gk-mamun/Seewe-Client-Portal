# ──────────────────────────────────────────────────────────────
#  API target — uncomment EXACTLY ONE VITE_API_BASE_URL below.
#  Vite reads env only at startup → restart `npm run dev` after editing.
#  (This file is git-ignored, so it's your personal/local setting.)
# ──────────────────────────────────────────────────────────────

# ── Live ──
# VITE_API_BASE_URL=https://team.seewework.com/api

# ── Dev ──
VITE_API_BASE_URL=https://team.seewework.com/api

# ── Local Laravel backend ──
# VITE_API_BASE_URL=http://localhost:8000/api

# ── Optional: where uploaded files (photos, certificates, agreements) load from.
#    Defaults to the API host minus `/api`. Override only if files live on a
#    different host than the API (e.g. API local, files on the live server).
# VITE_ASSET_BASE_URL=https://teamdev.seewework.com
